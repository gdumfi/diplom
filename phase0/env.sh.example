# ШАБЛОН. Скопируй в env.sh и впиши свои ключи: cp env.sh.example env.sh
# env.sh в .gitignore — реальные ключи в репозиторий НЕ попадают.

# RPC для форк-прогонов. publicnode — бесплатный, БЕЗ ключа, отдаёт полные ответы.
# publicnode = latest-состояние (не архив); форкать на latest (--fork-block 0).
export RPC_URL="https://ethereum-rpc.publicnode.com"

# Alchemy — для архивных запросов «до патча» (платный/свой ключ).
export RPC_URL_ALCHEMY="https://eth-mainnet.g.alchemy.com/v2/<ТВОЙ_ALCHEMY_KEY>"

# Etherscan — обязателен для --address фетча верифицированного исходника.
# Бесплатный ключ: https://etherscan.io/apis
export ETHERSCAN_API_KEY="<ТВОЙ_ETHERSCAN_KEY>"
