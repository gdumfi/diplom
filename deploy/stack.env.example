# Скопировать в stack.env и заполнить.  stack.env В ГИТ НЕ КОММИТИТЬ (секреты).
# ВАЖНО: файл читается через `env_file:` — значения передаются в контейнер КАК ЕСТЬ,
# поэтому знаки $ в bcrypt-хэше НЕ искажаются (в отличие от авто-.env). Ничего не экранировать.

# домен витрины. A-запись домена должна указывать на IP этого сервера —
# тогда Caddy сам выпустит и продлит HTTPS-сертификат (Let's Encrypt).
DOMAIN=scsa.example.com

# ключ Etherscan (v2, один на ETH/Base/Arbitrum/OP/BSC/Polygon).
# БЕЗ него скан «по адресу» не работает; скан «по .sol-файлу» работает и без него.
ETHERSCAN_API_KEY=

# ключ Alchemy — для форк-режима PoC. В веб-скане пока НЕ используется, можно пусто.
ALCHEMY_KEY=

# ── закрытый доступ (basic-auth) ──
# логин:
BASIC_AUTH_USER=admin
# хэш пароля (bcrypt). Сгенерировать:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'ВАШ_ПАРОЛЬ'
# вставить сюда ВЕСЬ вывод (начинается с $2a$…) одной строкой.
BASIC_AUTH_HASH=
